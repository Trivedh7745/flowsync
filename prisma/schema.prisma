generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  email     String
  date      String
  time      String
  createdAt DateTime @default(now())
}

model Workspace {
  id        String   @id @default(cuid())
  userId    String?  @unique
  name      String
  email     String   @unique
  company   String
  createdAt DateTime @default(now())
}

model Project {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  status      String     @default("In Progress")
  deadline    String?
  createdAt   DateTime   @default(now())
  clientId    String?
  budget      Int        @default(0)
  progress    Int        @default(0)
  revenue     Int        @default(0)
  documents   Document[]
  invoices    Invoice[]
  meetings    Meeting[]
  client      Client?    @relation(fields: [clientId], references: [id])
  tasks       Task[]
}

model Client {
  id        String     @id @default(cuid())
  userId    String
  name      String
  email     String
  company   String?
  createdAt DateTime   @default(now())
  documents Document[]
  invoices  Invoice[]
  meetings  Meeting[]
  projects  Project[]
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  status      String
  progress     Int      @default(0)
  priority    String
  createdAt   DateTime  @default(now())
  projectId   String
  dueDate     String?
  description String?
  subtasks    Subtask[]
  project     Project   @relation(fields: [projectId], references: [id])

  activities  Activity[]
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  taskId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String   @id @default(cuid())

  taskId      String

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  type        String

  title       String

  description String

  icon        String

  createdAt   DateTime @default(now())
}

model Invoice {
  id              String   @id @default(cuid())
  userId          String
  amount          Float
  status          String
  dueDate         DateTime?
  paidDate        DateTime?  
  createdAt       DateTime @default(now())
  clientId        String
  projectId       String
  invoiceNumber   String?  @unique
  client          Client   @relation(fields: [clientId], references: [id])
  project         Project  @relation(fields: [projectId], references: [id])
  issueDate       DateTime?
  paymentSchedule Boolean  @default(false)

  paymentSchedules PaymentSchedule[]
  emailSent        Boolean  @default(false)

  sentAt           DateTime?

  lastSentAt       DateTime?
  publicReceiptToken String? @unique

}

model PaymentSchedule {

  id         String    @id @default(cuid())

  invoiceId  String

  invoice    Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount     Float

  dueDate    DateTime

  paidDate   DateTime?

  createdAt  DateTime  @default(now())
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  name      String
  fileUrl   String
  createdAt DateTime @default(now())
  clientId  String?
  projectId String?
  client    Client?  @relation(fields: [clientId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])
}

model Meeting {
  id          String   @id @default(cuid())
  userId      String
  title       String
  date        String
  time        String
  meetingLink String
  notes       String
  status      String
  createdAt   DateTime @default(now())
  clientId    String
  projectId   String
  client      Client   @relation(fields: [clientId], references: [id])
  project     Project  @relation(fields: [projectId], references: [id])
}
